# Backend Environment Variables
PORT=5001
MONGODB_URI=mongodb://localhost:27017/event-sphere
JWT_SECRET=your_jwt_secret_here

# Resend Email Service
RESEND_API_KEY=re_your_api_key

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Public URL of the site (links in emails) — also doubles as the CORS
# allowlist in production. Comma-separate multiple origins if needed, e.g.
# FRONTEND_URL=https://app.example.com,https://www.example.com
# (the first value is the one used for email links)
FRONTEND_URL=http://localhost:8080

# Admin Configuration
ADMIN_EMAIL=admin@eventsphere.dev

# Local file storage (set to "true" to serve uploads from VM disk instead of Cloudinary)
USE_LOCAL_STORAGE=false
# Public URL used to build upload links returned to the frontend. Behind the
# Caddy reverse proxy, /uploads is routed to this backend on the SAME public
# domain — so in production this should be your public site URL (e.g.
# https://app.example.com), not the internal backend:5001 address.
BACKEND_URL=http://localhost:5001

# ── OTP Authentication ────────────────────────────────────────────────────────
# Set to "true" to enable phone/email OTP login. Leave "false" to disable entirely.
ENABLE_OTP_AUTH=false

# Resend (email OTP) — https://resend.com — free tier: 3,000 emails/month
# RESEND_API_KEY already defined above
EMAIL_FROM=City Pulse <noreply@citypulse.in>

# MSG91 (WhatsApp/SMS OTP) — https://msg91.com — cheapest for India
MSG91_API_KEY=your_msg91_authkey
MSG91_SENDER_ID=CPULSE
MSG91_TEMPLATE_ID=your_msg91_template_id
