# Backend Environment Variables
PORT=5001
MONGODB_URI=mongodb://localhost:27017/event-sphere
JWT_SECRET=your_jwt_secret_here

# ════════════════════════════════════════════════════════════════════════════════
# EMAIL SERVICE PROVIDER
# ════════════════════════════════════════════════════════════════════════════════
# Choose your email provider: "resend" (default) or "msg91"
# Both providers remain available - switch anytime by changing this value
EMAIL_PROVIDER=resend

# ── Resend Email Service ────────────────────────────────────────────────────────
# https://resend.com — Free tier: 3,000 emails/month, excellent deliverability
RESEND_API_KEY=re_your_api_key

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Public URL of the site (links in emails) — also doubles as the CORS
# allowlist in production. Comma-separate multiple origins if needed, e.g.
# FRONTEND_URL=https://app.example.com,https://www.example.com
# (the first value is the one used for email links)
FRONTEND_URL=http://localhost:8080

# Admin Configuration
ADMIN_EMAIL=admin@eventsphere.dev

# Set to "true" to enable Cloudinary for uploads. Defaults to "false" — every
# upload then falls back to local VM disk storage automatically, even if
# CLOUDINARY_* keys below happen to be set. Must match the frontend's
# VITE_CLOUDINARY_ENABLED (root .env) so both sides agree on where files land.
CLOUDINARY_ENABLED=false

# Local file storage — must be "true" whenever CLOUDINARY_ENABLED is "false",
# otherwise the /uploads static route never mounts and every uploaded file
# 404s in production even though it's sitting right there on disk.
USE_LOCAL_STORAGE=true
# Optional override for the public URL used to build upload links. Leave unset —
# it's derived per-request from the incoming Host header (Caddy forwards it, and
# Express trusts it via `trust proxy`), so it already matches your real domain.
# Only set this if you're NOT behind Caddy on the same domain as the API.
# BACKEND_URL=https://app.example.com

# ── OTP Authentication ────────────────────────────────────────────────────────
# Set to "true" to enable phone/email OTP login. Leave "false" to disable entirely.
ENABLE_OTP_AUTH=false

# Resend (email OTP) — https://resend.com — free tier: 3,000 emails/month
# RESEND_API_KEY already defined above
EMAIL_FROM=City Pulse <noreply@citypulse.in>

# ── MSG91 Email Service ─────────────────────────────────────────────────────────
# https://msg91.com — Cost-effective for India. Email sending is template-based:
# create ONE pass-through template in MSG91 (Email → Templates) with two
# variables named "subject" and "body", whose body just renders {{body}} —
# every email type in msg91EmailService.ts keeps generating its own HTML and
# is merged into this one template. Required only when EMAIL_PROVIDER=msg91.
MSG91_API_KEY=your_msg91_authkey
# The mailer91 sending domain from MSG91 → Email → Domains (e.g. yourcompany.mailer91.com,
# or your own verified custom domain).
MSG91_EMAIL_DOMAIN=yourcompany.mailer91.com
# Must be an address on MSG91_EMAIL_DOMAIN above.
MSG91_EMAIL_FROM=noreply@yourcompany.mailer91.com
MSG91_EMAIL_FROM_NAME=City Pulse
# The template_id of the pass-through template described above.
MSG91_EMAIL_TEMPLATE_ID=your_msg91_email_template_id

# ── MSG91 WhatsApp/SMS OTP ────────────────────────────────────────────────────────
MSG91_SENDER_ID=CPULSE
MSG91_TEMPLATE_ID=your_msg91_template_id

# ── MSG91 WhatsApp (ticket delivery) ──────────────────────────────────────────
# Uses the same MSG91_API_KEY above. Also requires CLOUDINARY_* env vars to host
# the ticket PDF, since WhatsApp needs a public media URL.
MSG91_WHATSAPP_NUMBER=your_whatsapp_integrated_number
MSG91_WHATSAPP_TEMPLATE_NAME=your_approved_template_name
MSG91_WHATSAPP_NAMESPACE=your_template_namespace

# Cloudinary (media storage — required by MSG91 WhatsApp ticket delivery above).
# Set CLOUDINARY_ENABLED=true above for these to actually take effect.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
