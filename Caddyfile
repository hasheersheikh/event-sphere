{$DOMAIN}

encode gzip zstd

# ── Backend routes — MUST come before any file-extension matcher, otherwise
#    /uploads/photo.jpg would match "/*.jpg" and get sent to the frontend (404).

# API routes - no caching for dynamic content
handle /api/* {
	header Cache-Control "no-store, no-cache, must-revalidate, private"
	header X-Content-Type-Options "nosniff"
	reverse_proxy backend:5001
}

# Uploaded media (local storage mode) - served by backend, 7 day cache
handle /uploads/* {
	header Cache-Control "public, max-age=604800, stale-while-revalidate=3600"
	header X-Content-Type-Options "nosniff"
	reverse_proxy backend:5001
}

# ── Frontend routes ──────────────────────────────────────────────────────────

# Vite build output - hashed filenames, safe to cache immutably for 1 year
handle /assets/* {
	header Cache-Control "public, max-age=31536000, immutable"
	header X-Content-Type-Options "nosniff"
	reverse_proxy frontend:80
}

# Service Worker - must always be fresh so deploys take effect
handle /sw.js {
	header Cache-Control "no-store, no-cache, must-revalidate, private"
	reverse_proxy frontend:80
}

# Manifest
handle /manifest.webmanifest {
	header Cache-Control "public, max-age=604800"
	reverse_proxy frontend:80
}

# Static images/fonts in public/ (e.g. /concert-crowd-live.jpg, /images/**,
# /favicon.svg) - 30 day cache. Uses regexp so it can't shadow /uploads or /api.
@staticfile path_regexp \.(jpg|jpeg|png|gif|svg|webp|avif|ico|woff2?)$
handle @staticfile {
	header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
	header X-Content-Type-Options "nosniff"
	reverse_proxy frontend:80
}

# Everything else (HTML + SPA fallback) - short cache so clients pick up new
# hashed asset names quickly after a deploy.
handle {
	header Cache-Control "public, max-age=60, must-revalidate"
	reverse_proxy frontend:80
}
