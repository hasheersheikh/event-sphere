# ── Reverse proxy (Caddy) ──────────────────────────────────────────────────────
# Your domain name (e.g. app.example.com) — Caddy auto-provisions a Let's
# Encrypt TLS cert for it. Leave as ":80" for IP-only/local testing (no HTTPS).
# Multiple hosts need a comma + space separator (Caddyfile requirement):
#   DOMAIN="example.com, www.example.com"
DOMAIN=:80

# ── Frontend build args (baked into the React bundle at build time) ───────────
# Caddy proxies /api/* to the backend on the same origin, so this should stay
# relative — no need to know the VM's IP/domain ahead of time.
VITE_API_URL=/api

# Google OAuth client ID
VITE_GOOGLE_CLIENT_ID=

# Set to "true" to enable Cloudinary for uploads. Defaults to "false" — every
# upload then falls back to local VM disk storage automatically, no other
# config needed. Must match the backend's CLOUDINARY_ENABLED (backend/.env).
VITE_CLOUDINARY_ENABLED=false

# Only needed when VITE_CLOUDINARY_ENABLED=true
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Razorpay public key
VITE_RAZORPAY_KEY_ID=
